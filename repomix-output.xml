    }

    if ($action === 'update_education') {
        $field = trim((string) ($_POST['field_of_study'] ?? ''));
        $proof = uploadProfileFile($_FILES['proof_file'] ?? [], ['pdf', 'jpg', 'jpeg', 'png']);
