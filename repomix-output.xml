    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.job-meta dd,
.modal-summary dd,
.requirements-list dd {
    margin-top: 3px;
    color: var(--ink);
    font-weight: 500;
}

.job-excerpt {
    color: var(--muted);
}

.empty-state {
    grid-column: 1 / -1;
    padding: 32px;
}

.empty-state p {
    margin-top: 8px;
    color: var(--muted);
}

.pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 32px;
}

.pagination-button {
    min-width: 44px;
    padding-inline: 14px;
}

.pagination-button.is-current {
    border-color: var(--gold);
    background: var(--gold);
    color: var(--white);
}

.pagination-button:disabled {
    opacity: 0.48;
    cursor: not-allowed;
}

.modal {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    place-items: center;
    padding: 24px;
}

.modal[hidden] {
    display: none;
}

.modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(21, 35, 30, 0.72);
}

.modal-card {
    position: relative;
    width: min(860px, 100%);
    max-height: min(760px, calc(100vh - 48px));
    overflow: auto;
    padding: 32px;
    box-shadow: 0 20px 48px rgba(21, 35, 30, 0.18);
}

.modal-close {
    position: absolute;
    top: 18px;
    right: 18px;
    display: inline-flex;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
}

.modal-close:hover {
    border-color: var(--forest);
    color: var(--forest);
}

.modal-close svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
}

.modal-content {
    display: grid;
    gap: 24px;
}

.modal-company {
    color: var(--gold);
    font-weight: 600;
}

.modal-summary {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 18px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
}

.modal-section {
    display: grid;
    gap: 10px;
}

.modal-section p,
.requirements-list dd {
    color: var(--muted);
}

.requirements-list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.skills-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.skill-tag {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 6px 10px;
    border: 1px solid rgba(185, 138, 46, 0.35);
    border-radius: 5px;
    background: rgba(185, 138, 46, 0.1);
    color: var(--ink);
    font-weight: 600;
}

.modal-actions {
    display: grid;
    gap: 12px;
    justify-items: start;
    padding-top: 6px;
}

.apply-message {
    color: var(--muted);
}

.apply-message a,
.auth-switch a {
    color: var(--gold);
    font-weight: 600;
}

.site-footer {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding: 28px var(--page-gutter);
    border-top: 1px solid var(--line);
    color: var(--muted);
}

.site-footer p:first-child {
    color: var(--ink);
    font-weight: 600;
}

.auth-main {
    min-height: calc(100vh - 73px);
    display: grid;
    align-items: center;
    padding: 56px var(--page-gutter);
}

.auth-split {
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    padding: 0;
}

.auth-shell {
    display: grid;
    align-content: center;
    justify-items: center;
    padding: clamp(48px, 5vw, 64px);
    background: var(--paper);
}

.auth-photo {
    min-height: calc(100vh - 73px);
}

.auth-photo-login {
    background-image: url("../images/login-side.jpg");
}

.auth-photo-register {
    background-image: url("../images/register-side.jpg");
}

.auth-card {
    width: min(100%, 520px);
    padding: 32px;
}

.auth-card p {
    color: var(--muted);
}

.auth-form {
    display: grid;
    gap: 18px;
    margin-top: 26px;
}

.auth-card .button-primary {
    width: 100%;
    margin-top: 4px;
}

.auth-switch {
    margin-top: 20px;
    text-align: center;
}

.form-alert {
    margin-top: 20px;
    padding: 12px 14px;
    border: 1px solid rgba(185, 138, 46, 0.34);
    border-radius: 5px;
    background: rgba(185, 138, 46, 0.1);
    color: var(--ink);
    font-weight: 600;
}

.placeholder-main {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: var(--page-gutter);
    background: var(--paper);
}

.placeholder-card {
    display: grid;
    gap: 16px;
    width: min(100%, 620px);
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--white);
}

.placeholder-card p:not(.section-kicker) {
    color: var(--muted);
}

.placeholder-card .button-primary {
    width: max-content;
}

.profile-main {
    min-height: calc(100vh - 73px);
    padding: 48px var(--page-gutter);
    background: var(--paper);
}

.profile-card {
    display: grid;
    gap: 22px;
    width: 100%;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--white);
}

.profile-card > p:not(.section-kicker),
.profile-form-section > p {
    color: var(--muted);
}

.profile-form {
    display: grid;
    gap: 28px;
}

.profile-form-section {
    display: grid;
    gap: 18px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.full-span {
    grid-column: 1 / -1;
}

.form-field textarea {
    width: 100%;
    min-height: 120px;
    resize: vertical;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--white);
    color: var(--ink);
    padding: 10px 12px;
    outline: none;
    transition: border-color 180ms ease, box-shadow 180ms ease;
}

.form-field textarea:focus {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(185, 138, 46, 0.14);
}

.repeat-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}

.repeat-list {
    display: grid;
    gap: 14px;
}

.repeat-block,
.company-summary {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
}

.checkbox-field {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-weight: 600;
}

.checkbox-field input {
    width: 18px;
    height: 18px;
    accent-color: var(--gold);
}

.company-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.company-summary div {
    display: grid;
    gap: 5px;
}

.company-summary span {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.company-summary strong {
    font-size: 1rem;
}

.panel-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
}

.vacancy-form {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.vacancy-modal {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    display: none;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(21, 35, 30, 0.6);
    overflow-y: auto;
}

.vacancy-modal.is-open {
    display: flex;
}

.vacancy-modal-backdrop {
    position: absolute;
    inset: 0;
}

.vacancy-modal-card {
    position: relative;
    z-index: 1;
    width: min(600px, 100%);
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    padding: 40px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--white);
    box-shadow: 0 24px 70px rgba(21, 35, 30, 0.28);
}

.vacancy-modal-card h2 {
    margin-bottom: 24px;
}

.vacancy-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    display: inline-flex;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
}

.vacancy-modal-close:hover {
    border-color: var(--forest);
    color: var(--forest);
}

.vacancy-modal-close svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
}

body.modal-open {
    overflow: hidden;
}

.approval-actions form {
    margin: 0;
}

.seeker-page {
    display: grid;
    gap: 24px;
}

.seeker-page .section-heading > p:not(.section-kicker),
.seeker-card > p {
    color: var(--muted);
}

.seeker-nav-actions span {
    color: var(--muted);
    font-weight: 600;
}

.admin-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

.seeker-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.admin-stat-card {
    display: grid;
    gap: 8px;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--white);
}

.admin-stat-card strong {
    font-family: "Fraunces", Georgia, serif;
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
}

.admin-stat-card span {
    color: var(--muted);
    font-weight: 600;
}

.application-list {
    display: grid;
    gap: 16px;
}

.application-card {
    display: grid;
    gap: 18px;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--white);
}

.application-card h2 {
    font-size: 1.35rem;
}

.status-tag {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    width: max-content;
    padding: 5px 9px;
    border-radius: 5px;
    font-size: 0.82rem;
    font-weight: 700;
}

.status-tag.pending,
.status-tag.applied {
    border: 1px solid rgba(185, 138, 46, 0.34);
    background: rgba(185, 138, 46, 0.11);
    color: var(--ink);
}

.status-tag.exchange-awaiting-approval {
    border: 1px solid rgba(185, 138, 46, 0.42);
    background: rgba(185, 138, 46, 0.14);
    color: var(--gold);
}

.status-tag.exchange-pending {
    border: 1px solid rgba(92, 107, 99, 0.28);
    background: rgba(92, 107, 99, 0.08);
    color: var(--muted);
}

.status-tag.exchange-negotiating {
    border: 1px solid rgba(43, 74, 62, 0.28);
    background: rgba(43, 74, 62, 0.1);
    color: var(--forest);
}

.status-tag.exchange-accepted {
    border: 1px solid var(--forest);
    background: var(--forest);
    color: var(--white);
}

.status-tag.exchange-rejected {
    border: 1px solid rgba(146, 68, 68, 0.28);
    background: rgba(146, 68, 68, 0.1);
    color: #924444;
}

.status-tag.approved,
.status-tag.completed,
.status-tag.active,
.status-tag.shortlisted,
.status-tag.hired,
.status-tag.accepted {
    border: 1px solid rgba(43, 74, 62, 0.28);
    background: rgba(43, 74, 62, 0.1);
    color: var(--forest);
}

.status-tag.closed,
.status-tag.rejected {
    border: 1px solid var(--line);
    background: var(--paper-deep);
    color: var(--muted);
}

.feedback-note {
    padding: 12px 14px;
    border-left: 3px solid var(--gold);
    background: var(--paper-deep);
    color: var(--muted);
}

.profile-section-card {
    align-content: start;
}

.profile-detail-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
}

.profile-detail-grid div {
    display: grid;
    gap: 5px;
}

.profile-detail-grid span,
.muted-text {
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 600;
}

.profile-detail-grid strong {
    font-size: 1rem;
}

.text-link {
    color: var(--gold);
    font-weight: 700;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
}

.profile-thumb {
    width: 92px;
    height: 92px;
    border: 1px solid var(--line);
    border-radius: 6px;
    object-fit: cover;
}

.profile-entry {
    display: grid;
    gap: 14px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
}

.profile-entry:first-of-type {
    border-top: 0;
}

.profile-entry p {
    margin-top: 6px;
    color: var(--muted);
}

.edit-panel {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
}

.skill-entry {
    width: 100%;
}

.role-picker {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    border: 0;
}

.role-option {
    display: grid;
    gap: 6px;
    min-height: 102px;
    padding: 18px;
    cursor: pointer;
    transition: border-color 180ms ease, background-color 180ms ease;
}

.role-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}

.role-option span {
    font-weight: 700;
}

.role-option small {
    color: var(--muted);
    line-height: 1.4;
}

.role-option.is-selected {
    border-color: var(--gold);
    background: rgba(185, 138, 46, 0.1);
}

.employer-fields[hidden] {
    display: none;
}

.job-card-button:focus-visible,
.nav-button:focus-visible,
.nav-link:focus-visible,
.button-primary:focus-visible,
.button-outline:focus-visible,
.pagination-button:focus-visible,
.modal-close:focus-visible,
.role-option:focus-within,
.auth-switch a:focus-visible,
.apply-message a:focus-visible,
.site-logo:focus-visible {
    outline: 3px solid rgba(185, 138, 46, 0.42);
    outline-offset: 3px;
}

@media (max-width: 900px) {
    .site-nav {
        min-height: 64px;
    }

    .site-logo {
        font-size: 1.3rem;
    }

    .nav-actions {
        gap: 8px;
    }

    .nav-button {
        min-height: 38px;
        padding: 8px 12px;
    }

    .hero-section {
        padding-top: 60px;
        padding-bottom: 48px;
    }

    .hero-layout,
    .auth-split {
        grid-template-columns: 1fr;
    }

    .hero-image {
        min-height: 320px;
    }

    .auth-main {
        padding: 0;
    }

    .auth-photo {
        display: none;
    }

    .job-search-section {
        padding-top: 24px;
        padding-bottom: 24px;
    }

    .job-search-form,
    .job-listings,
    .modal-summary,
    .requirements-list,
    .form-grid,
    .company-summary,
    .profile-detail-grid,
    .admin-stats,
    .seeker-stats {
        grid-template-columns: 1fr;
    }

    .job-card-button {
        padding: 24px;
    }
}

@media (max-width: 620px) {
    .site-nav {
        gap: 12px;
    }

    .site-logo {
        font-size: 1.2rem;
    }

    .nav-actions {
        flex-shrink: 0;
    }

    .nav-button {
        padding-inline: 10px;
        font-size: 0.92rem;
    }

    .listings-header,
    .site-footer {
        align-items: start;
        flex-direction: column;
    }

    .job-meta,
    .role-picker {
        grid-template-columns: 1fr;
    }

    .pagination {
        flex-wrap: wrap;
    }

    .modal {
        padding: 12px;
    }

    .modal-card,
    .auth-card,
    .profile-card {
        padding: 24px;
    }

    .repeat-heading {
        align-items: start;
        flex-direction: column;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
    }

    .job-card:hover,
    .job-card:focus-within {
        transform: none;
    }
}
